# Get a free key at https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key in. .env.local is gitignored —
# never commit a real key. This variable has no NEXT_PUBLIC_ prefix on purpose:
# that is what keeps it on the server and out of the browser bundle.
GEMINI_API_KEY=your-key-here

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
